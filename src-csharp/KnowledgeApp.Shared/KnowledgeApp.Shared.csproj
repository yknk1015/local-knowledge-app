<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><Version>0.7.1</Version><PlatformTarget>x64</PlatformTarget><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KnowledgeApp.Data/KnowledgeApp.Data.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <Compile Include="../KnowledgeApp.CSharp/AuthenticationCommandDispatcher.cs" Link="AuthenticationCommandDispatcher.cs" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../KnowledgeApp.PathProbe/KnowledgeApp.PathProbe.csproj" ReferenceOutputAssembly="false" /></ItemGroup>
  <Target Name="CopyStorageProbeRuntime" AfterTargets="Build;Publish">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../KnowledgeApp.PathProbe/KnowledgeApp.PathProbe.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="ProbeAssembly" />
    </MSBuild>
    <PropertyGroup><ProbeDirectory>@(ProbeAssembly->'%(RootDir)%(Directory)')</ProbeDirectory></PropertyGroup>
    <ItemGroup><ProbeRuntime Include="$(ProbeDirectory)KnowledgeApp.PathProbe.*" Exclude="$(ProbeDirectory)*.pdb" /></ItemGroup>
    <Copy SourceFiles="@(ProbeRuntime)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ProbeRuntime)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != '' And Exists('$(PublishDir)')" />
  </Target>
</Project>
